# Copy to deploy/.env and fill in real values. Never commit deploy/.env.

MYSQL_ROOT_PASSWORD=change-me
GORILLAHR_DB_PASSWORD=change-me
RECRUITMENT_DB_PASSWORD=change-me

# HR (GorillaHR) — HS256 secret, same role as backend/.env's SECRET_KEY today.
# Superseded once Identity issues RS256 tokens (P3); until then this stays real.
HR_SECRET_KEY=change-me-to-a-long-random-string

# Recruitment.Gorilla — HS256 secret (min 32 bytes), same role as the
# `Jwt:Key` user secret today. Superseded once RG becomes an OIDC client (P2).
ATS_JWT_KEY=change-me-to-a-32-byte-minimum-random-string

# First Super Admin, seeded once at boot when Users is empty (Program.cs).
# ATS_SEED_ADMIN_PASSWORD_HASH must be in RG's PBKDF2 "iterations.saltB64.hashB64"
# format (Auth/PasswordHasher.cs) — generate it with the app, not by hand.
ATS_SEED_ADMIN_EMAIL=admin@recruitmentgorilla.com
ATS_SEED_ADMIN_PASSWORD_HASH=change-me
